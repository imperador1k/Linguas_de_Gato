{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "apps/client",
      "framework": "vite",
      "installCommand": "cd ../.. && npm install --include=dev"
    },
    "server": {
      "root": "apps/server",
      "framework": "fastify",
      "entrypoint": "dist/index.js",
      "installCommand": "cd ../.. && npm install --include=dev",
      "buildCommand": "cd ../.. && npm run build --workspace @ldg/shared && npm run build --workspace @ldg/server"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
