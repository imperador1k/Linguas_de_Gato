# Copy this file to apps/server/.env and fill in the values.
# .env is git-ignored. Never commit real keys.

# Groq API key (https://console.groq.com/keys). Enables automatic transcription, speaking
# feedback and AI exercise generation. It stays on this server: it is never sent to the browser.
# Privacy: recordings you transcribe, transcripts you submit for feedback, and the text you
# send when you press "Generate" are sent to Groq. This app deletes its temporary copy after
# each request; Groq's retention is governed by your Groq account settings and policies.
GROQ_API_KEY=

# Chat model for speaking feedback and exercise generation. Default: openai/gpt-oss-120b (supports strict
# Structured Outputs on Groq). Any Groq chat model id works.
GROQ_CHAT_MODEL=
# auto (strict JSON Schema for models documented to support it, JSON Object Mode otherwise),
# json_schema, or json_object. Output is always validated by the server.
GROQ_CHAT_RESPONSE_FORMAT=auto
# low | medium | high. Sent only to GPT-OSS models.
GROQ_REASONING_EFFORT=medium
# Upper bound for one feedback or generation request, in seconds (10-600).
ASSESSMENT_TIMEOUT_SECONDS=120

# Maximum upload size for transcription, in MB (default 25, the Groq free-tier limit).
# Raise it (up to 100) only if your Groq plan accepts larger files.
TRANSCRIPTION_MAX_UPLOAD_MB=25

# Upper bound for one transcription request, upload included, in seconds (10-1800).
TRANSCRIPTION_TIMEOUT_SECONDS=300

# Groq API base URL. Leave empty for the official endpoint. Only https URLs, or
# http on 127.0.0.1/localhost (for a local test stub), are accepted.
GROQ_API_BASE_URL=

# Network binding. Keep 127.0.0.1 unless you know you need LAN access.
HOST=127.0.0.1
PORT=3001

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
